(* Multiboot2.def — Definitions for the Multiboot2 specification.
   Based on the multiboot2.h header from the Free Software Foundation.
   Conforms to Multiboot2 specification version 2.0. *)

DEFINITION MODULE Multiboot2;

FROM SYSTEM IMPORT BYTE, CARDINAL8, CARDINAL16, CARDINAL32, CARDINAL64;

(* ========================================================================
   Constants
   ======================================================================== *)

CONST
    (* Search and alignment *)
    MULTIBOOT_SEARCH        = 32768;
    MULTIBOOT_HEADER_ALIGN  = 8;

    (* Magic numbers *)
    MULTIBOOT2_HEADER_MAGIC      = 0E85250D6H;
    MULTIBOOT2_BOOTLOADER_MAGIC  = 036D76289H;

    (* Module and info alignment *)
    MULTIBOOT_MOD_ALIGN   = 00001000H;
    MULTIBOOT_INFO_ALIGN  = 00000008H;

    (* General tag alignment *)
    MULTIBOOT_TAG_ALIGN   = 8;

    (* Tag types for the boot info structure *)
    MULTIBOOT_TAG_TYPE_END              = 0;
    MULTIBOOT_TAG_TYPE_CMDLINE          = 1;
    MULTIBOOT_TAG_TYPE_BOOT_LOADER_NAME = 2;
    MULTIBOOT_TAG_TYPE_MODULE           = 3;
    MULTIBOOT_TAG_TYPE_BASIC_MEMINFO    = 4;
    MULTIBOOT_TAG_TYPE_BOOTDEV          = 5;
    MULTIBOOT_TAG_TYPE_MMAP             = 6;
    MULTIBOOT_TAG_TYPE_VBE              = 7;
    MULTIBOOT_TAG_TYPE_FRAMEBUFFER      = 8;
    MULTIBOOT_TAG_TYPE_ELF_SECTIONS     = 9;
    MULTIBOOT_TAG_TYPE_APM              = 10;
    MULTIBOOT_TAG_TYPE_EFI32            = 11;
    MULTIBOOT_TAG_TYPE_EFI64            = 12;
    MULTIBOOT_TAG_TYPE_SMBIOS           = 13;
    MULTIBOOT_TAG_TYPE_ACPI_OLD         = 14;
    MULTIBOOT_TAG_TYPE_ACPI_NEW         = 15;
    MULTIBOOT_TAG_TYPE_NETWORK          = 16;
    MULTIBOOT_TAG_TYPE_EFI_MMAP         = 17;
    MULTIBOOT_TAG_TYPE_EFI_BS           = 18;
    MULTIBOOT_TAG_TYPE_EFI32_IH         = 19;
    MULTIBOOT_TAG_TYPE_EFI64_IH         = 20;
    MULTIBOOT_TAG_TYPE_LOAD_BASE_ADDR   = 21;

    (* Header tag types *)
    MULTIBOOT_HEADER_TAG_END                  = 0;
    MULTIBOOT_HEADER_TAG_INFORMATION_REQUEST  = 1;
    MULTIBOOT_HEADER_TAG_ADDRESS              = 2;
    MULTIBOOT_HEADER_TAG_ENTRY_ADDRESS        = 3;
    MULTIBOOT_HEADER_TAG_CONSOLE_FLAGS        = 4;
    MULTIBOOT_HEADER_TAG_FRAMEBUFFER          = 5;
    MULTIBOOT_HEADER_TAG_MODULE_ALIGN         = 6;
    MULTIBOOT_HEADER_TAG_EFI_BS               = 7;
    MULTIBOOT_HEADER_TAG_ENTRY_ADDRESS_EFI32  = 8;
    MULTIBOOT_HEADER_TAG_ENTRY_ADDRESS_EFI64  = 9;
    MULTIBOOT_HEADER_TAG_RELOCATABLE           = 10;

    (* Architecture identifiers *)
    MULTIBOOT_ARCHITECTURE_I386   = 0;
    MULTIBOOT_ARCHITECTURE_MIPS32 = 4;
    MULTIBOOT_HEADER_TAG_OPTIONAL = 1;

    (* Load preferences *)
    MULTIBOOT_LOAD_PREFERENCE_NONE = 0;
    MULTIBOOT_LOAD_PREFERENCE_LOW  = 1;
    MULTIBOOT_LOAD_PREFERENCE_HIGH = 2;

    (* Console flags *)
    MULTIBOOT_CONSOLE_FLAGS_CONSOLE_REQUIRED    = 1;
    MULTIBOOT_CONSOLE_FLAGS_EGA_TEXT_SUPPORTED  = 2;

    (* Memory map entry types *)
    MULTIBOOT_MEMORY_AVAILABLE       = 1;
    MULTIBOOT_MEMORY_RESERVED        = 2;
    MULTIBOOT_MEMORY_ACPI_RECLAIMABLE = 3;
    MULTIBOOT_MEMORY_NVS             = 4;
    MULTIBOOT_MEMORY_BADRAM          = 5;

    (* Framebuffer types *)
    MULTIBOOT_FRAMEBUFFER_TYPE_INDEXED   = 0;
    MULTIBOOT_FRAMEBUFFER_TYPE_RGB       = 1;
    MULTIBOOT_FRAMEBUFFER_TYPE_EGA_TEXT  = 2;


(* ========================================================================
   Type definitions — tag structures
   ======================================================================== *)

TYPE
    (* ---- Generic tag (every tag starts with these two fields) ---- *)
    MultibootTag = RECORD
        tagType: CARDINAL32;
        size:    CARDINAL32;
    END;
    MultibootTagPtr = POINTER TO MultibootTag;

    (* ---- String tag (type 1, 2) — string data follows at offset 8 ---- *)
    MultibootTagString = RECORD
        tagType: CARDINAL32;
        size:    CARDINAL32;
    END;
    MultibootTagStringPtr = POINTER TO MultibootTagString;

    (* ---- Module tag (type 3) ---- *)
    MultibootTagModule = RECORD
        tagType:   CARDINAL32;
        size:      CARDINAL32;
        modStart:  CARDINAL32;
        modEnd:    CARDINAL32;
    END;
    MultibootTagModulePtr = POINTER TO MultibootTagModule;

    (* ---- Basic memory info (type 4) ---- *)
    MultibootTagBasicMeminfo = RECORD
        tagType:   CARDINAL32;
        size:      CARDINAL32;
        memLower:  CARDINAL32;
        memUpper:  CARDINAL32;
    END;
    MultibootTagBasicMeminfoPtr = POINTER TO MultibootTagBasicMeminfo;

    (* ---- Boot device (type 5) ---- *)
    MultibootTagBootdev = RECORD
        tagType: CARDINAL32;
        size:    CARDINAL32;
        biosdev: CARDINAL32;
        slice:   CARDINAL32;
        part:    CARDINAL32;
    END;
    MultibootTagBootdevPtr = POINTER TO MultibootTagBootdev;

    (* ---- Memory map entry (used inside the MMAP tag) ---- *)
    MultibootMmapEntry = RECORD
        addr:      CARDINAL64;
        len:       CARDINAL64;
        entryType: CARDINAL32;
        zero:      CARDINAL32;
    END;
    MultibootMmapEntryPtr = POINTER TO MultibootMmapEntry;

    (* ---- Memory map tag (type 6) ---- *)
    MultibootTagMmap = RECORD
        tagType:      CARDINAL32;
        size:         CARDINAL32;
        entrySize:    CARDINAL32;
        entryVersion: CARDINAL32;
    END;
    MultibootTagMmapPtr = POINTER TO MultibootTagMmap;

    (* ---- ELF sections tag (type 9) ---- *)
    MultibootTagElfSections = RECORD
        tagType: CARDINAL32;
        size:    CARDINAL32;
        num:     CARDINAL32;
        entsize: CARDINAL32;
        shndx:   CARDINAL32;
    END;
    MultibootTagElfSectionsPtr = POINTER TO MultibootTagElfSections;

    (* ---- APM tag (type 10) ---- *)
    MultibootTagApm = RECORD
        tagType:  CARDINAL32;
        size:     CARDINAL32;
        version:  CARDINAL16;
        cseg:     CARDINAL16;
        offset:   CARDINAL32;
        cseg16:   CARDINAL16;
        dseg:     CARDINAL16;
        flags:    CARDINAL16;
        csegLen:  CARDINAL16;
        cseg16Len: CARDINAL16;
        dsegLen:  CARDINAL16;
    END;
    MultibootTagApmPtr = POINTER TO MultibootTagApm;

    (* ---- EFI32 tag (type 11, 19) ---- *)
    MultibootTagEfi32 = RECORD
        tagType: CARDINAL32;
        size:    CARDINAL32;
        pointer: CARDINAL32;
    END;
    MultibootTagEfi32Ptr = POINTER TO MultibootTagEfi32;

    (* ---- EFI64 tag (type 12, 20) ---- *)
    MultibootTagEfi64 = RECORD
        tagType: CARDINAL32;
        size:    CARDINAL32;
        pointer: CARDINAL64;
    END;
    MultibootTagEfi64Ptr = POINTER TO MultibootTagEfi64;

    (* ---- VBE info block (512 bytes) ---- *)
    MultibootVbeInfoBlock = RECORD
        data: ARRAY [0..511] OF BYTE;
    END;

    (* ---- VBE mode info block (256 bytes) ---- *)
    MultibootVbeModeInfoBlock = RECORD
        data: ARRAY [0..255] OF BYTE;
    END;

    (* ---- VBE tag (type 7) ---- *)
    MultibootTagVbe = RECORD
        tagType:           CARDINAL32;
        size:              CARDINAL32;
        vbeMode:           CARDINAL16;
        vbeInterfaceSeg:   CARDINAL16;
        vbeInterfaceOff:   CARDINAL16;
        vbeInterfaceLen:   CARDINAL16;
        vbeControlInfo:    MultibootVbeInfoBlock;
        vbeModeInfo:       MultibootVbeModeInfoBlock;
    END;
    MultibootTagVbePtr = POINTER TO MultibootTagVbe;

    (* ---- Framebuffer tag (type 8) — common fields only ---- *)
    MultibootTagFramebuffer = RECORD
        tagType:           CARDINAL32;
        size:              CARDINAL32;
        framebufferAddr:   CARDINAL64;
        framebufferPitch:  CARDINAL32;
        framebufferWidth:  CARDINAL32;
        framebufferHeight: CARDINAL32;
        framebufferBpp:    CARDINAL8;
        framebufferType:   CARDINAL8;
        reserved:          CARDINAL16;
    END;
    MultibootTagFramebufferPtr = POINTER TO MultibootTagFramebuffer;

    (* ---- SMBIOS tag (type 13) ---- *)
    MultibootTagSmbios = RECORD
        tagType:  CARDINAL32;
        size:     CARDINAL32;
        major:    CARDINAL8;
        minor:    CARDINAL8;
        reserved: ARRAY [0..5] OF BYTE;
    END;
    MultibootTagSmbiosPtr = POINTER TO MultibootTagSmbios;

    (* ---- Old ACPI tag (type 14) ---- *)
    MultibootTagOldAcpi = RECORD
        tagType: CARDINAL32;
        size:    CARDINAL32;
    END;
    MultibootTagOldAcpiPtr = POINTER TO MultibootTagOldAcpi;

    (* ---- New ACPI tag (type 15) ---- *)
    MultibootTagNewAcpi = RECORD
        tagType: CARDINAL32;
        size:    CARDINAL32;
    END;
    MultibootTagNewAcpiPtr = POINTER TO MultibootTagNewAcpi;

    (* ---- Network tag (type 16) ---- *)
    MultibootTagNetwork = RECORD
        tagType: CARDINAL32;
        size:    CARDINAL32;
    END;
    MultibootTagNetworkPtr = POINTER TO MultibootTagNetwork;

    (* ---- EFI memory map tag (type 17) ---- *)
    MultibootTagEfiMmap = RECORD
        tagType:    CARDINAL32;
        size:       CARDINAL32;
        descrSize:  CARDINAL32;
        descrVers:  CARDINAL32;
    END;
    MultibootTagEfiMmapPtr = POINTER TO MultibootTagEfiMmap;

    (* ---- Load base address tag (type 21) ---- *)
    MultibootTagLoadBaseAddr = RECORD
        tagType:      CARDINAL32;
        size:         CARDINAL32;
        loadBaseAddr: CARDINAL32;
    END;
    MultibootTagLoadBaseAddrPtr = POINTER TO MultibootTagLoadBaseAddr;

END Multiboot2.